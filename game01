function intro(i){
  clearInterval(tick);const L=LV[i];
  stage.innerHTML='<span class="tag '+(L.lv==='高級'?'hi':L.lv==='中級'?'mid':'')+'">第 '+(i+1)+' 關 · '+L.lv+'</span><h2>'+L.t+'</h2><p>'+L.d+'</p><p class="mute">共 '+L.q.length+' 題'+(L.pw?' ＋ 密碼設計挑戰（300 分）':'')+'。每題 100 分，連續答對有連擊獎勵'+(L.timed?'，剩餘秒數 × 5 為時間獎勵':'')+'。</p><div class="row"><button class="btn" id="go">出發！</button><button class="btn ghost" id="bk">返回總部</button></div>';
  $('#go').onclick=()=>{G={i,qs:shuffle(L.q),k:0,ok:0,score:0,combo:0,best:0,pw:!!L.pw,miss:[]};G.pw?pwLab():ask()};$('#bk').onclick=home;$('#go').focus();

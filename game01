function ask(){
  const L=LV[G.i],Q=G.qs[G.k],n=G.qs.length;
  const opts=Q.tf?['正確 ✓','錯誤 ✗']:Q.o;
  stage.innerHTML='<div class="qhead"><span>第 '+(G.i+1)+' 關 · '+L.t+'</span><span class="num">題 '+(G.k+1)+'/'+n+' · '+G.score+' 分'+(G.combo>1?' · 連擊 ×'+G.combo:'')+(L.timed?' · <span class="timer" id="tm">'+L.timed+'s</span>':'')+'</span></div>'+
  '<div class="bar"><i style="width:'+(G.k/n*100)+'%"></i></div>'+(Q.tf?'<span class="tag">判斷對錯</span>':'')+
  '<p class="q">'+Q.q+'</p>'+(Q.s?'<ol class="stmts">'+Q.s.map(s=>'<li>'+s+'</li>').join('')+'</ol>':'')+
  '<div class="opts '+(Q.tf||opts.length>4?'two':'')+'">'+opts.map((o,j)=>'<button class="opt" data-j="'+j+'"><span class="k num">'+'ABCDEF'[j]+'</span><span>'+o+'</span></button>').join('')+'</div><div id="fb"></div>';
  stage.querySelectorAll('.opt').forEach(b=>b.onclick=()=>answer(+b.dataset.j));
  if(L.timed){let t=L.timed;G.left=t;tick=setInterval(()=>{t--;G.left=t;const e=$('#tm');if(e)e.textContent=t+'s';if(t<=0){clearInterval(tick);answer(-1)}},1000)}
}
function answer(j){
  clearInterval(tick);const L=LV[G.i],Q=G.qs[G.k],ok=j===Q.a;
  stage.querySelectorAll('.opt').forEach((b,x)=>{b.disabled=true;if(x===Q.a)b.classList.add('right');else if(x===j)b.classList.add('wrong')});
  let gain=0;
  if(ok){G.ok++;G.combo++;G.best=Math.max(G.best,G.combo);gain=100+Math.min(100,20*(G.combo-1))+(L.timed?Math.max(0,G.left)*5:0);G.score+=gain}
  else{G.combo=0;G.miss.push(Q.q)}
  const last=G.k===G.qs.length-1;
  $('#fb').innerHTML='<div class="fb '+(ok?'ok':'no')+'" role="status"><strong>'+(ok?pick(PRAISE)+' +'+gain+' 分':j<0?'時間到！':pick(OOPS))+'</strong>'+Q.e+'</div><div class="row"><button class="btn" id="nx">'+(last?'查看成績':'下一題')+'</button></div>';
  $('#nx').onclick=()=>{G.k++;last?result():ask()};$('#nx').focus();
}
function pwLab(){
  const COMMON=['password','123456','qwerty','abc123','111111','iloveyou','admin'];
  const R=[['至少 8 個字符',p=>p.length>=8],['至少 1 個數字',p=>/\d/.test(p)],['至少 1 個大寫字母',p=>/[A-Z]/.test(p)],['至少 1 個小寫字母',p=>/[a-z]/.test(p)],['至少 1 個特殊字符（如 # ! @ $）',p=>/[^A-Za-z0-9]/.test(p)],['不是常見字詞或簡單數列',p=>p.length>0&&!COMMON.some(c=>p.toLowerCase().includes(c))&&!/(\d)\1{3}|1234|2345|3456|4567|5678|6789/.test(p)],['不像生日或電話（不可有 6 個以上連續數字）',p=>p.length>0&&!/\d{6,}/.test(p)]];
  stage.innerHTML='<span class="tag mid">密碼設計挑戰</span><h2>設計一個強密碼</h2><p class="mute">輸入一個<b>虛構</b>的密碼（不要用你真正的密碼！），滿足全部七項規則即可獲得 300 分。</p>'+
  '<label for="pw"><b>試輸入密碼</b></label><input type="text" id="pw" autocomplete="off" spellcheck="false" style="margin-top:8px"><div class="meter" style="margin-top:12px"><i id="mt" style="width:0"></i></div><p id="lab" class="mute" style="margin:6px 0 0">強度：—</p>'+
  '<ul class="rules" id="rl"></ul><div class="row"><button class="btn" id="ok" disabled>提交密碼</button><button class="btn ghost" id="sk">跳過（0 分）</button></div>';
  const upd=()=>{const p=$('#pw').value,n=R.filter(r=>r[1](p)).length;
   $('#rl').innerHTML=R.map(r=>'<li class="'+(r[1](p)?'on':'')+'">'+(r[1](p)?'✓ ':'○ ')+r[0]+'</li>').join('');
   const c=n<=3?'#d1342a':n<=5?'#f0a000':n<7?'#7bbf2a':'#0f8a4b';$('#mt').style.width=(n/7*100)+'%';$('#mt').style.background=c;
   $('#lab').textContent='強度：'+(p?['極弱','極弱','弱','弱','中','中','強','非常強'][n]:'—');$('#ok').disabled=n<7};
  $('#pw').oninput=upd;upd();$('#pw').focus();
  const go=pts=>{G.score+=pts;G.pwPts=pts;
   stage.innerHTML='<div class="fb '+(pts?'ok':'no')+'"><strong>'+(pts?'密碼合格！+300 分':'已跳過密碼挑戰')+'</strong>好密碼要夠長、混合不同字符，又不可包含個人資料。記住：定期更換、不要共用、不要在不同系統用同一組密碼。</div><div class="row"><button class="btn" id="nx">開始密碼問答</button></div>';
   $('#nx').onclick=ask;$('#nx').focus()};
  $('#ok').onclick=()=>go(300);$('#sk').onclick=()=>go(0);
}
function comment(p){return p>=.9?'表現出色！你對這部分已經非常熟練。':p>=.75?'做得好！還有少量概念可以再鞏固。':p>=.6?'成功過關！建議重溫錯題的解釋，再挑戰拿更多星星。':'未能過關。先重溫課本相關部分，再試一次，你一定做得到！'}
function result(){
  const L=LV[G.i],pct=G.ok/G.qs.length,prev=S.res[G.i],ok=pct>=.6;
  if(!prev||G.score>prev.score||(pct>prev.pct))S.res[G.i]={pct:Math.max(pct,prev?prev.pct:0),score:Math.max(G.score,prev?prev.score:0)};
  save();hud();const st=stars(pct);
  if(ok&&LV.every((_,i)=>passed(i)))return finale(true);
  stage.innerHTML='<span class="tag '+(ok?'':'hi')+'">第 '+(G.i+1)+' 關 · '+(ok?'過關':'未過關')+'</span><h2>'+L.t+'：'+(ok?'任務成功！':'任務失敗')+'</h2>'+
  '<p class="big num" style="color:#e0a800">'+'★'.repeat(st)+'<span style="opacity:.3">'+'★'.repeat(3-st)+'</span></p>'+
  '<p>答對 <b class="num">'+G.ok+' / '+G.qs.length+'</b>（'+Math.round(pct*100)+'%）· 本次得分 <b class="num">'+G.score+'</b> · 最高連擊 <b class="num">'+G.best+'</b></p>'+
  '<div class="fb '+(ok?'ok':'no')+'"><strong>教官評語</strong>'+comment(pct)+'</div>'+
  (G.miss.length?'<p style="margin-top:16px"><b>需要重溫的題目：</b></p><ul class="mute">'+G.miss.map(m=>'<li>'+m+'</li>').join('')+'</ul>':'')+
  '<div class="row">'+(ok&&G.i<5?'<button class="btn" id="nx">前往第 '+(G.i+2)+' 關</button>':'')+'<button class="btn '+(ok?'ghost':'')+'" id="re">再玩一次</button><button class="btn ghost" id="hm">返回總部</button></div>';
  if($('#nx'))$('#nx').onclick=()=>intro(G.i+1);$('#re').onclick=()=>intro(G.i);$('#hm').onclick=home;
}
function finale(fresh){
  const ps=LV.map((_,i)=>S.res[i].pct),avg=ps.reduce((a,b)=>a+b,0)/6,weak=ps.indexOf(Math.min(...ps));
  const rank=avg>=.9?'網絡安全大師':avg>=.75?'資深防衛特工':'合格網絡特工';
  const allStars=ps.reduce((t,p)=>t+stars(p),0);
  stage.innerHTML='<div class="done"><span class="tag hi">全部六關已完成</span><h2>任務完成！</h2><p style="font-size:20px">恭喜特工 <b>'+esc(S.name)+'</b>，你成功守護了網絡世界！</p>'+
  '<p class="mute" style="margin:18px 0 4px">總分</p><p class="big num">'+total()+'</p>'+
  '<p style="margin-top:14px">稱號：<b style="color:var(--coral);font-size:22px">'+rank+'</b> · 星星 <b class="num">'+allStars+' / 18</b></p></div>'+
  '<div class="lvls">'+LV.map((L,i)=>'<div class="lv"><b>第 '+(i+1)+' 關 · '+L.t+'</b><span class="st">'+'★'.repeat(stars(ps[i]))+'☆'.repeat(3-stars(ps[i]))+'</span><span class="s mute num">'+Math.round(ps[i]*100)+'% · '+S.res[i].score+' 分</span></div>').join('')+'</div>'+
  '<div class="fb ok"><strong>教官總評</strong>'+(avg>=.9?'你對第五課的概念掌握得非常全面，可以嘗試幫同學溫習！':'整體表現不錯。你在「'+LV[weak].t+'」的得分最低，建議重玩這一關，爭取三星。')+'</div>'+
  '<div class="row" style="justify-content:center"><button class="btn" id="rp">重玩「'+LV[weak].t+'」</button><button class="btn ghost" id="hm">查看總部</button></div>';
  $('#rp').onclick=()=>intro(weak);$('#hm').onclick=()=>{stage.innerHTML='';homeList()};
  if(fresh){const c=$('#conf'),cols=['#ff5a3c','#ffd23f','#2b50ff','#5fe39a','#fff'];c.innerHTML=Array.from({length:70},()=>'<i style="left:'+Math.random()*100+'%;background:'+pick(cols)+';animation-delay:'+(Math.random()*1.2)+'s"></i>').join('');setTimeout(()=>c.innerHTML='',4800)}
}
function homeList(){
  stage.innerHTML='<span class="tag">任務總部</span><h2>重玩任何一關，刷新最高分</h2><div class="lvls">'+LV.map((L,i)=>'<button class="opt" data-i="'+i+'"><span class="k num">'+(i+1)+'</span><span>'+L.t+'（'+L.lv+'）· '+Math.round(S.res[i].pct*100)+'%</span></button>').join('')+'</div><div class="row"><button class="btn" id="fn">返回完成畫面</button></div>';
  stage.querySelectorAll('.opt').forEach(b=>b.onclick=()=>intro(+b.dataset.i));$('#fn').onclick=()=>finale();
}
hud();home();
}
</script>
</body>
